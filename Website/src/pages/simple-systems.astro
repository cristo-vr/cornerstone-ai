---
import Base from "../layouts/Base.astro";
import Newsletter from "../components/Newsletter.astro";

const title = "Simple Systems";
const description =
  "Notes from Cristo Van Rensburg on scaling by simplifying: what's coming out of my own business and the ones I help, in a world that keeps getting more complex. Free, one click to leave.";
---
<Base title={title} description={description} minimal image="/og-simple-systems.png">
  <section class="wrap min-h-[100dvh] flex flex-col justify-center" style="padding-top: var(--nav-h)">
    <div id="nav-sentinel" class="absolute top-0 h-px w-px" aria-hidden="true"></div>
    <div class="grid lg:grid-cols-12 gap-x-12 gap-y-12 py-16 md:py-24 items-start">
      <div class="lg:col-span-7">
        <p class="label rise">Simple Systems</p>
        <h1 class="display display-1 mt-4 rise" style="--d: 80ms">Simple scales.</h1>
        <div class="mt-8 grid gap-5 max-w-[52ch] text-[1.1rem] leading-[1.6] text-text-2 rise" style="--d: 180ms">
          <p>
            I'm building a company and helping other founders scale theirs, and the same thing keeps proving true. The businesses that get past their ceiling aren't the ones adding the most. They're the ones getting simpler while everything around them gets more complex.
          </p>
          <p>
            Simple Systems is where I write that down as I go. What I'm taking out of my own business this month, what worked for a client, what I got wrong and had to undo. Founder to founder, in plain English, with nothing to sell at the end of it.
          </p>
        </div>
        <div class="mt-10 max-w-[34rem] rise" style="--d: 280ms">
          <Newsletter large buttonLabel="Send me the next one" id="news-page" />
          <p class="mt-3 text-[0.85rem] text-text-3">Free. One click to leave.</p>
        </div>
      </div>

      <div class="lg:col-span-4 lg:col-start-9 grid gap-8 rise" style="--d: 360ms">
        <div class="rule pt-6">
          <h2 class="display display-4">From the work, not the theory</h2>
          <p class="mt-3 text-text-2 text-[0.98rem]">
            Every issue starts with something that happened, in my business or a client's. If nothing happened, there's no issue that week.
          </p>
        </div>
        <div class="rule pt-6">
          <h2 class="display display-4">Written by me</h2>
          <p class="mt-3 text-text-2 text-[0.98rem]">
            <a href="/about" class="link text-text">Cristo Van Rensburg</a>. I run Cornerstone AI. Nobody ghostwrites this, and the weeks I got something wrong get written up too. Those are the useful ones.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
