---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import GapsMap from "../components/advisors/GapsMap.astro";
import cristo from "../assets/images/cristo-headshot.webp";
import { QUESTIONS } from "../lib/advisor-questions";
import demoPreview from "../assets/images/demo-preview.jpg";
import { GATE_VIDEO, LIVE, LINKEDIN_PARTNER_ID, META_PIXEL_ID, SHOW_VIDEO, videoSource } from "../lib/advisors-config";

/**
 * /advisors: the page for wealth advisor teams. Light Cool Concrete. The offer, the demo, the
 * blueprint form, the questions advisors ask. The video returns once the new one is recorded.
 *
 * No prices, no invented proof, no dashes.
 *
 * Pixels render only on a live build (PUBLIC_FUNNEL_LIVE=1). Every event goes
 * through src/scripts/funnel-client.ts.
 */

const title = "For wealth advisors | Cornerstone";
const description =
  "We move your team off scattered spreadsheets and onto one custom system in 30 days. Try the demo, then book your free blueprint.";

const video = videoSource(import.meta.env.DEV);
const PIXEL_ID = META_PIXEL_ID;
const LI_ID = LINKEDIN_PARTNER_ID;

/** Headline, video, form, FAQ: the other sections stay in the file, switched off
 *  (Cristo, 2026-10-31). Set true to bring them back. */
const SHOW_DETAIL = false;

const faqs = [
  {
    q: "What about compliance?",
    a: [
      "No client data goes into the system until your compliance officer signs off. Every record keeps who captured it and who signed it off, so the FAIS and FICA trail is there when you need it.",
    ],
  },
  {
    q: "Where does client data live?",
    a: [
      "In a database set up in your practice's name, not ours. You can export all of it at any time, and if we stop working together it stays with you. We handle personal information under POPIA.",
    ],
  },
  {
    q: "Will my team use it?",
    a: [
      "We build it around how your team already works, and roll it out with them. Training and support are included. The big CRM usually gets dropped because nobody sat with the team. We sit with them.",
    ],
  },
  {
    q: "Do I own it?",
    a: ["The data is yours, and the platform runs on accounts in your practice's name. The code and the architecture stay ours, and your licence lets you run it."],
  },
  {
    q: "What is the free blueprint?",
    a: ["We meet your team in 1-on-1 sessions, identify your bottlenecks and design your system. You get a custom blueprint, detailed enough to build without us. It's yours, whether you ever work with us or not. If you'd like us to build it, that'll be the next step."],
  },
  {
    q: "What's the guarantee?",
    a: ["If you don't want to keep it after 30 days, you get every cent back. There are three conditions: we get access to what we need to build it, your team shows up to the sessions we set together, and your team uses it on their real work for the 30 days."],
  },
  { q: "What does it cost?", a: ["It depends on the size of your team. We go through it on the call, once we've seen how your practice runs."] },
  {
    q: "Is this AI software?",
    a: [
      "It's a system for how work moves through your practice. Some steps use AI where it takes work off your team, and that comes last, once the process itself works.",
    ],
  },
];

/** What we build: the four parts the VSL shows. */
const parts = [
  {
    t: "The compliance register",
    d: "Every ROA, FICA check and sign off is recorded as the work happens, with who did what and when. When compliance asks, you export it.",
  },
  {
    t: "One record per client",
    d: "Family members, providers, documents and every piece of work in one place, so anyone on the team can pick up any client.",
  },
  {
    t: "Your processes, step by step",
    d: "Onboarding, annual reviews, new business and medical aid changes run as steps, so you can see what's in progress, overdue or waiting on a client.",
  },
  {
    t: "Client contact from the step",
    d: "Emails go out from the step they belong to, documents come back through a secure link, and signatures stay with the record.",
  },
];
---
<Base title={title} description={description} bare noindex theme="light">
  <Fragment slot="head">
    {SHOW_VIDEO && video.hls && <link rel="preconnect" href="https://media.cornerstone-ai.pro" crossorigin />}
    {SHOW_VIDEO && <link rel="preload" as="image" href={video.poster} />}
    {LIVE && (
      <script is:inline define:vars={{ PIXEL_ID }}>
        (function () {
          try { if (localStorage.getItem("cs_internal") === "1") return; } catch (e) {}
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
          document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', PIXEL_ID);
          fbq('track', 'PageView');
        })();
      </script>
    )}
    {LIVE && LI_ID && (
      <script is:inline define:vars={{ LI_ID }}>
        (function () {
          try { if (localStorage.getItem("cs_internal") === "1") return; } catch (e) {}
          window._linkedin_partner_id = LI_ID;
          window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
          window._linkedin_data_partner_ids.push(LI_ID);
          (function (l) {
            if (!l) { window.lintrk = function (a, b) { window.lintrk.q.push([a, b]); }; window.lintrk.q = []; }
            var s = document.getElementsByTagName("script")[0];
            var b = document.createElement("script");
            b.type = "text/javascript"; b.async = true;
            b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
            s.parentNode.insertBefore(b, s);
          })(window.lintrk);
        })();
      </script>
    )}
  </Fragment>


  <div class="axp">
  <!-- ── 1. Hero: headline, the video ─────────────────────────────────────── -->
  <section class="ax-hero wrap">
    <div class="mx-auto max-w-[60rem] text-center">
      <p class="label rise">For wealth advisors</p>
      <h1 class="ax-h1 display rise mt-3 leading-[0.92]" style="--d: 80ms">
        We move your team off scattered spreadsheets and onto <span class="ax-mark">one custom system in 30 days</span> so that the chaos becomes capacity for more clients, and you can finally see everything.
      </h1>
    </div>

    <div class="ax-stage rise mx-auto" style="--d: 240ms">
      <a class="ax-demo" href="/advisors/demo?from=hero" data-cta="demo">
        <Image src={demoPreview} alt="The example system, showing every missing document across a firm" widths={[480, 800, 1200]} sizes="(min-width: 768px) 56rem, 100vw" class="ax-demo-img" loading="eager" />
        <span class="ax-demo-cta"><span class="btn btn-primary">Try the demo<span class="arrow" aria-hidden="true">&nbsp;&rarr;</span></span></span>
      </a>
      <p class="ax-demo-note">Click around a working example. Example system, with made-up clients.</p>
      {SHOW_VIDEO && (
      <div
        id="vsl"
        class="vsl relative aspect-video w-full overflow-hidden bg-sunken"
        data-hls={video.hls ?? ""}
        data-mp4={video.mp4}
        data-gate={GATE_VIDEO ? "1" : "0"}
      >
        <video
          id="vsl-video"
          class="absolute inset-0 h-full w-full"
          poster={video.poster}
          preload="none"
          playsinline
          controlslist="nodownload"
          disablepictureinpicture
          hidden
        ></video>

        <!-- Before the first play: the greyed first frame, one big button, and
             the speeds. A speed chip starts the video at that speed. -->
        <div id="vsl-start" class="vsl-start absolute inset-0">
          <img src={video.poster} alt="" class="vsl-poster absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
          <span class="vsl-wash absolute inset-0" aria-hidden="true"></span>
          <div class="relative flex h-full flex-col items-center justify-center gap-4 md:gap-6">
            <button id="vsl-play" type="button" class="vsl-play grid h-16 w-16 place-items-center rounded-full bg-accent md:h-24 md:w-24" aria-label="Play the video, about 7 minutes">
              <svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 md:h-9 md:w-9" aria-hidden="true"><path d="M6 4l14 8-14 8z" fill="#141310"></path></svg>
            </button>
            <div class="vsl-speeds" role="group" aria-label="Play faster">
              <button type="button" data-rate="1.2">1.2x</button>
              <button type="button" data-rate="1.5">1.5x</button>
              <button type="button" data-rate="1.7">1.7x</button>
              <button type="button" data-rate="2">2x</button>
            </div>
          </div>
        </div>

        <!-- While it plays: tap to pause, a big button when paused, one bar. -->
        <button id="vsl-resume" type="button" class="vsl-resume absolute inset-0 grid place-items-center" aria-label="Play" hidden>
          <span class="vsl-play grid h-14 w-14 place-items-center rounded-full bg-accent md:h-20 md:w-20" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="ml-1 h-5 w-5 md:h-8 md:w-8"><path d="M6 4l14 8-14 8z" fill="#141310"></path></svg>
          </span>
        </button>
        <div id="vsl-bar" class="vsl-bar" hidden>
          <button id="vsl-toggle" type="button" class="vsl-icon" aria-label="Pause">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"></path><path class="i-play" d="M7 4.5l12 7.5-12 7.5z" fill="currentColor"></path></svg>
          </button>
          <span id="vsl-time" class="vsl-time">0:00</span>
          <input id="vsl-seek" class="vsl-seek" type="range" min="0" max="1000" step="1" value="0" aria-label="Seek" />
          <button id="vsl-rate" type="button" class="vsl-rate" aria-label="Playback speed, 1x">1x</button>
          <button id="vsl-full" type="button" class="vsl-icon" aria-label="Full screen">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
          </button>
        </div>
        {video.badge && <span class="ax-badge">{video.badge}</span>}
      </div>
      )}
      <p id="vsl-gate-note" class="mt-2 text-center text-[0.9rem] text-text-2" hidden>Add your name and email below and the video starts.</p>
    </div>
  </section>

  <!-- ── 2. Application, straight under the video. On a laptop step 1 is one
       row (name, email, Continue) so it shares the first screen with the
       video; steps 2 to 7 open in the same card. ─────────────────────────── -->
  <section id="apply" class="ax-apply wrap scroll-mt-4">
        <div id="ax" class="ax-card ax-form-card scroll-mt-4">
          <div class="ax-form-head">
            <h2 class="display ax-form-h">Book your free blueprint</h2>
            <div id="ax-progress" class="ax-form-prog">
              <div class="ax-progress" aria-hidden="true"><span id="ax-bar"></span></div>
            </div>
          </div>

          <div class="ax-form-body">
          <p id="ax-resume" class="mb-5 border-l-2 border-accent pl-3 text-[0.95rem] text-text-2" hidden></p>

          <form id="ax-form" novalidate>
            <!-- 1. name and email: form_start -->
            <fieldset class="ax-step" data-step="1" data-key="contact">
              <legend class="ax-q">Start here</legend>
              <div class="field mt-5">
                <label for="ax-name">Your name</label>
                <input id="ax-name" class="input" type="text" autocomplete="name" maxlength="120" required aria-describedby="ax-name-err" />
                <p id="ax-name-err" class="error" hidden></p>
              </div>
              <div class="field mt-4">
                <label for="ax-email">Work email</label>
                <input id="ax-email" class="input" type="email" autocomplete="email" inputmode="email" maxlength="320" required aria-describedby="ax-email-err" />
                <p id="ax-email-err" class="error" hidden></p>
              </div>
              <div class="absolute -left-[9999px]" aria-hidden="true">
                <label for="ax-company">Leave this field empty</label>
                <input id="ax-company" type="text" tabindex="-1" autocomplete="off" />
              </div>
              <p class="mt-4 text-[0.88rem] text-text-3">We'll email you about your application. You can unsubscribe from any email.</p>
            </fieldset>

            {QUESTIONS.map((q, i) => (
              <fieldset class="ax-step" data-step={i + 2} data-key={q.key} hidden>
                <legend class="ax-q">{q.question}</legend>
                {q.helper && <p class="mt-1 text-[0.9rem] text-text-3">{q.helper}</p>}
                {q.kind === "single" ? (
                  <div class={`ax-opts mt-5 ${q.options.length > 4 ? "ax-opts-2" : ""}`}>
                    {q.options.map((o) => (
                      <button type="button" class="ax-opt" data-field={q.key} data-value={o.value} aria-pressed="false">{o.label}</button>
                    ))}
                  </div>
                ) : (
                  <div class="ax-chips mt-5">
                    {q.options.map((o) => (
                      <button type="button" class="ax-chip" data-field={q.key} data-value={o.value} aria-pressed="false">{o.label}</button>
                    ))}
                  </div>
                )}
              </fieldset>
            ))}

            <div id="ax-turnstile" class="ax-ts" aria-live="polite"></div>

            <p id="ax-error" class="mt-4 min-h-[1.2em] text-[0.92rem] text-danger-ink" role="alert"></p>

            <div id="ax-actions" class="mt-3 flex items-center justify-between gap-4">
              <button type="button" id="ax-back" class="ax-textbtn" hidden>Back</button>
              <span></span>
              <button type="submit" id="ax-next" class="btn btn-primary">Continue<span class="arrow" aria-hidden="true">&nbsp;&rarr;</span></button>
            </div>
          </form>

          <!-- booking: qualified -->
          <div id="ax-book" hidden tabindex="-1">
            <h3 class="ax-q">Pick a time for your blueprint discovery call</h3>
            <p class="mt-1 text-[0.9rem] text-text-3">Times are in your time zone. 45 minutes on Google Meet.</p>
            <div class="mt-5">
              <p id="ax-cal-loading" class="text-text-3" aria-live="polite">Finding open times...</p>
              <div id="ax-days" class="ax-days" role="group" aria-label="Choose a day" hidden></div>
              <div id="ax-times" class="ax-times mt-4" role="group" aria-label="Choose a time" hidden></div>
            </div>
            <p id="ax-picked-wrap" class="mt-5 text-text" hidden>You picked <strong id="ax-picked"></strong>.</p>
            <div class="field mt-6">
              <label for="ax-phone">WhatsApp number (optional)</label>
              <div class="ax-phone">
                <div class="ax-cc">
                  <span id="ax-cc-label" class="input ax-cc-face" aria-hidden="true">+27</span>
                  <select id="ax-country" aria-label="Country code" autocomplete="tel-country-code"></select>
                </div>
                <input id="ax-phone" class="input" type="tel" autocomplete="tel-national" inputmode="tel" maxlength="24" aria-describedby="ax-phone-hint" />
              </div>
              <p id="ax-phone-hint" class="hint">For a reminder on the day.</p>
            </div>
            <p id="ax-book-error" class="mt-4 min-h-[1.2em] text-[0.92rem] text-danger-ink" role="alert"></p>
            <div class="mt-3 flex justify-end">
              <button type="button" id="ax-book-btn" class="btn btn-primary" disabled>Book this time<span class="arrow" aria-hidden="true">&nbsp;&rarr;</span></button>
            </div>
          </div>

          <!-- confirmation: booked -->
          <div id="ax-done" class="text-center" hidden tabindex="-1">
            <h3 id="ax-done-h" class="display display-4">You're booked.</h3>
            <p id="ax-done-when" class="mt-4 text-text-2"></p>
            <p class="mt-5 border-t border-line-2 pt-5 text-text"><span class="label block">Before the call</span><span class="mt-2 block">Pick the one process that eats most of your week. We'll start there.</span></p>
          </div>

          <!-- thank you: disqualified -->
          <div id="ax-dq" class="text-center" hidden tabindex="-1">
            <h3 id="ax-dq-h" class="display display-4">Thanks.</h3>
            <p id="ax-dq-why" class="mt-4 text-text-2"></p>
            <p class="mt-3 text-text-2">We've saved your answers, so you won't need to start over.</p>
            <button type="button" id="ax-dq-back" class="ax-textbtn mt-6">I picked the wrong answer</button>
          </div>
          </div>
        </div>

      <div class="ax-meta">
        <p>Free, and yours to keep, whether you ever work with us or not.</p>
      </div>

      <div class="ax-apply-aside">
        <div class="ax-aside-head">
          <h3 class="label">How the free blueprint works</h3>
          <p class="ax-small">
            We use your answers to prepare for the call. Read our <a class="link" href="/privacy">privacy policy</a>.
          </p>
        </div>
        <ol class="ax-oncall">
          <li><span class="num" aria-hidden="true">01</span>A 45 minute blueprint discovery call, to see if it's a fit.</li>
          <li><span class="num" aria-hidden="true">02</span>We meet your team in 1-on-1 sessions, identify your bottlenecks and measure where they stand today.</li>
          <li><span class="num" aria-hidden="true">03</span>We design your system, around how your team really works.</li>
          <li><span class="num" aria-hidden="true">04</span>You get your custom blueprint, detailed enough to build without us. If you'd like us to build it, that'll be the next step.</li>
        </ol>
      </div>
  </section>

  {SHOW_DETAIL && (<Fragment>
  <!-- ── 3. The five second version ────────────────────────────────────────── -->
  <section class="ax-sec ax-band">
    <div class="wrap">
      <div>
        <div class="ax-intro" data-ax-rv>
          <h2 class="display ax-h2">Every gap runs through you.</h2>
          <p class="ax-lead mt-5 max-w-[44ch]">
            None of it talks to the rest. So you became the system that fills the gaps, and every new client adds to the load.
          </p>
        </div>
        <div class="mt-12 md:mt-16" data-ax-rv style="--d: 80ms">
          <GapsMap />
        </div>
      </div>
    </div>
  </section>

  <!-- ── 4. What we build ──────────────────────────────────────────────────── -->
  <section class="ax-sec">
    <div class="wrap">
      <div class="ax-build">
        <div class="ax-build-head" data-ax-rv>
          <h2 class="display ax-h2">What we build</h2>
          <p class="ax-lead mt-5 max-w-[34ch]">
            One system for how work moves through your practice, set up around how your team already works.
          </p>
          <ol class="ax-build-index" aria-hidden="true">
            {parts.map((p, i) => (
              <li data-ax-idx={i}><span class="num">{String(i + 1).padStart(2, "0")}</span>{p.t}</li>
            ))}
          </ol>
        </div>
        <ol class="ax-parts">
          {parts.map((p, i) => (
            <li data-ax-rv data-ax-part={i} style={`--d: ${i * 60}ms`}>
              <span class="num ax-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="ax-h3">{p.t}</h3>
                <p class="mt-2">{p.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ── 5. Fit ────────────────────────────────────────────────────────────── -->
  <section class="ax-sec ax-ruled">
    <div class="wrap">
      <div>
        <h2 class="display ax-h2 max-w-[18ch]" data-ax-rv>Built for advisors with a team behind them.</h2>
        <div class="ax-fitgrid mt-10 md:mt-14">
          <div class="ax-card ax-fit-yes" data-ax-rv>
            <h3 class="label">This is for you if</h3>
            <ul class="ax-fit mt-6">
              <li>You advise on your own book of clients.</li>
              <li>You have at least one admin or support person working with you.</li>
              <li>You look after 100 or more client households.</li>
              <li>You'd rather grow the book than hire people to carry it.</li>
            </ul>
          </div>
          <div class="ax-fit-no" data-ax-rv style="--d: 90ms">
            <h3 class="label">This isn't for you if</h3>
            <ul class="ax-fit is-no mt-6">
              <li>You need more clients first. We fix how the work moves. Finding clients is a different job.</li>
              <li>You want software dropped off and left with you. This only works with your team, so your team has to give it time.</li>
              <li>You work in support or admin. Send this page to the advisor you work with.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  </Fragment>)}

  <!-- ── 7. Questions advisors ask ─────────────────────────────────────────── -->
  <section class="ax-sec">
    <div class="wrap">
      <div>
        <h2 class="display ax-h2" data-ax-rv>Questions advisors ask</h2>
        <dl class="ax-faq mt-10 md:mt-14">
          {faqs.map((f, i) => (
            <div data-ax-rv style={`--d: ${(i % 2) * 60}ms`}>
              <dt class="ax-h3">{f.q}</dt>
              <dd>{f.a.map((p) => <p>{p}</p>)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  {SHOW_DETAIL && (<Fragment>
  <!-- ── 8. Founder ────────────────────────────────────────────────────────── -->
  <section class="ax-sec ax-ruled">
    <div class="wrap">
      <div class="ax-founder">
        <div class="ax-founder-photo" data-ax-rv>
          <Image src={cristo} alt="Cristo van Rensburg, founder of Cornerstone" widths={[320, 520, 720]} sizes="(min-width: 768px) 24rem, 70vw" class="w-full" loading="lazy" />
        </div>
        <div data-ax-rv style="--d: 90ms">
          <h2 class="display ax-h2">Who you'll speak to</h2>
          <div class="mt-6 grid gap-4">
            <p class="ax-lead">I'm Cristo van Rensburg, founder of Cornerstone. I've spent five years building systems for businesses, and this year I've been building one inside a Joburg advisor's practice.</p>
            <p>She looks after 200+ client households with four support staff, and the work ran on a half used task board, spreadsheets and her memory. We started with one record per client, FICA and documents included, and a list of every missing document across the book. We're working through the rest with her team, one process at a time.</p>
            <p>Every hour your team gets back is room for another client, and one less evening checking their work.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  </Fragment>)}
  </div>

  <div id="ax-sticky" class="ax-sticky" inert>
    <a href="#apply" class="btn btn-primary flex-1 justify-center" data-cta="sticky">Book your free blueprint<span class="arrow" aria-hidden="true">&nbsp;&rarr;</span></a>
  </div>

  <p slot="footer-note" class="w-full max-w-[60rem] text-[0.8rem] leading-[1.5] text-text-3">
    This site uses cookies, the Meta Pixel and the LinkedIn Insight Tag to see which ads bring people here and to show our ads to people who've visited. We handle your personal information under POPIA, as set out in our privacy policy.
  </p>
</Base>

<style is:global>
  /* ── Page tokens. Scoped to .axp so global.css and every other page stay as
     they are. Brass has one value on this page: #D1A24F, and only as a fill
     (button, bar, tick, square). #141310 sits on it, #A6792B is hover only.
     No brass type, no brass tints, no halos. ───────────────────────────── */
  .axp {
    --ax-fill: var(--color-accent);
    --ax-sec: clamp(4.5rem, 9vw, 8rem);
    --ax-card-bg: var(--color-surface-3);
    --ax-shadow: 0 1px 0 rgb(255 253 247 / 0.8) inset, 0 2px 4px rgb(58 50 36 / 0.06), 0 30px 60px -36px rgb(58 50 36 / 0.42);
    --ax-tile: #f7f6f2;
