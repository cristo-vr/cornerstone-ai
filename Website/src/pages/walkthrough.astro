---
import Base from "../layouts/Base.astro";
import { WALKTHROUGH_READY, walkthroughSource } from "../lib/advisors-config";

/**
 * /walkthrough, and /w/<code> (public/_redirects): the page a lead from a LinkedIn
 * form is sent to, by email and SMS, with a link that is personal to them.
 *
 * The video and the booking, nothing else. The calendar is on the page from the
 * first second, so nobody has to finish the video before they can book.
 * Two fair questions, and no answer turns anyone away.
 */
const video = walkthroughSource(import.meta.env.DEV);
---
<Base title="Your walkthrough video | Cornerstone" description="The walkthrough video, and where to book your first Blueprint session." bare noindex theme="light">
  <main class="wt">
    <h1>Your walkthrough video</h1>

    {WALKTHROUGH_READY ? (
      <video id="wt-video" class="wt-video" controls playsinline preload="metadata" poster={video.poster} data-hls={video.hls ?? ""} data-mp4={video.mp4}></video>
    ) : (
      <div class="wt-video wt-soon"><p>The video will be here shortly.</p></div>
    )}

    <section id="wt-book" class="wt-book" hidden>
      <h2>Book your first Blueprint session</h2>
      <p class="wt-sub">It's the top of the U, where we start with you. There's no commitment.</p>

      <fieldset>
        <legend>Do you have an admin or support team?</legend>
        <div class="wt-chips" data-q="has_team">
          <button type="button" data-v="yes">Yes, I have a team</button>
          <button type="button" data-v="no">Not yet</button>
        </div>
      </fieldset>
      <fieldset>
        <legend>What are you looking for?</legend>
        <div class="wt-chips" data-q="looking_for">
          <button type="button" data-v="operations">Help scaling our operations</button>
          <button type="button" data-v="leads">Lead generation</button>
        </div>
      </fieldset>

      <fieldset>
        <legend>Pick a time</legend>
        <p id="wt-loading" class="wt-note">Finding open times...</p>
        <div id="wt-days" class="wt-chips wt-days" hidden></div>
        <div id="wt-times" class="wt-chips" hidden></div>
      </fieldset>

      <div id="wt-turnstile"></div>
      <button id="wt-go" class="wt-go" type="button" disabled>Book this time</button>
      <p id="wt-err" class="wt-err" role="alert"></p>
    </section>

    <section id="wt-done" class="wt-book" hidden>
      <h2 id="wt-done-h">You're booked.</h2>
      <p id="wt-done-when" class="wt-sub"></p>
    </section>

    <p id="wt-nolink" class="wt-note" hidden>To book, open the link in your email or SMS.</p>
  </main>
</Base>

<style is:global>
  /* The bare layout's logo floats over the top of the page, so clear it. */
  .wt { max-width: 860px; margin: 0 auto; padding: calc(var(--nav-h) + 8px) 18px 72px; }
  .wt h1 { font: 800 clamp(1.9rem, 6vw, 3.4rem)/0.98 var(--font-display); text-transform: uppercase; margin: 0 0 16px; color: var(--color-text); }
  .wt-video { display: block; width: 100%; aspect-ratio: 1668 / 1080; background: #1c1b18; border-radius: 4px; }
  .wt-soon { display: grid; place-items: center; }
  .wt-soon p { color: #ece9e2; margin: 0; }
  .wt-book { margin-top: 34px; }
  .wt-book h2 { font: 800 clamp(1.8rem, 5vw, 2.6rem)/1 var(--font-display); text-transform: uppercase; margin: 0; color: var(--color-text); }
  .wt-sub { margin: 10px 0 0; color: var(--color-text-2); font-size: 1.05rem; line-height: 1.45; }
  .wt fieldset { border: 0; padding: 0; margin: 24px 0 0; }
  .wt legend { padding: 0; margin-bottom: 10px; font-weight: 600; color: var(--color-text); }
  .wt-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .wt-chips button { min-height: 44px; padding: 8px 16px; border: 1px solid var(--color-line-3); border-radius: 8px; background: transparent; color: var(--color-text); font: 500 0.98rem var(--font-body); cursor: pointer; }
  .wt-chips button:hover { border-color: var(--color-accent-dk); }
  .wt-chips button.is-picked { background: var(--color-accent); border-color: var(--color-accent); color: #141310; font-weight: 600; }
  .wt-times-gap, #wt-times { margin-top: 12px; }
  /* Days and times line up in columns rather than wrapping raggedly. */
  #wt-days:not([hidden]) { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); }
  #wt-times:not([hidden]) { display: grid; grid-template-columns: repeat(auto-fill, minmax(70px, 1fr)); }
  #wt-days button, #wt-times button { padding-inline: 4px; }
  @media (max-width: 520px) { .wt-chips[data-q] button { flex: 1 1 100%; } }
  .wt-note { margin: 0; color: var(--color-text-2); }
  #wt-nolink { margin-top: 24px; }
  .wt-go { display: block; width: 100%; min-height: 56px; margin-top: 24px; border: 0; border-radius: 10px; background: var(--color-accent); color: #141310; font: 800 1.5rem var(--font-display); text-transform: uppercase; cursor: pointer; }
  .wt-go:hover:not(:disabled) { background: var(--color-accent-dk); }
  .wt-go:disabled { opacity: 0.55; cursor: not-allowed; }
  .wt-err { margin: 12px 0 0; color: #8e3524; font-weight: 500; }
  .wt-err:empty { display: none; }
</style>

<script src="../scripts/walkthrough.ts"></script>
