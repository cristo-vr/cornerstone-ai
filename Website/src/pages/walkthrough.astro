---
import Base from "../layouts/Base.astro";
import { WALKTHROUGH_READY, walkthroughSource } from "../lib/advisors-config";

/**
 * /walkthrough, and /w/<code> (public/_redirects): the page a lead from a LinkedIn
 * form is sent to, by email and SMS, with a link that is personal to them.
 *
 * The video and the booking, nothing else. The calendar is on the page from the
 * first second, so nobody has to finish the video before they can book.
 * Two fair questions, and no answer turns anyone away.
 */
const video = walkthroughSource(import.meta.env.DEV);
---
<Base title="Your walkthrough video | Cornerstone" description="The walkthrough video, and where to book your first Blueprint session." bare noindex theme="light">
  <main class="wt">
    <h1>Your walkthrough video</h1>

    {WALKTHROUGH_READY ? (
      <div id="vsl" class="vsl wt-video relative w-full overflow-hidden" data-hls={video.hls ?? ""} data-mp4={video.mp4}>
        <video
          id="vsl-video"
          class="absolute inset-0 h-full w-full"
          poster={video.poster}
          preload="none"
          playsinline
          controlslist="nodownload"
          disablepictureinpicture
          hidden
        ></video>

        <!-- Before the first play: the greyed first frame, one big button, and
             the speeds. A speed chip starts the video at that speed. -->
        <div id="vsl-start" class="vsl-start absolute inset-0">
          <img src={video.poster} alt="" class="vsl-poster absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
          <span class="vsl-wash absolute inset-0" aria-hidden="true"></span>
          <div class="relative flex h-full flex-col items-center justify-center gap-4 md:gap-6">
            <button id="vsl-play" type="button" class="vsl-play grid h-16 w-16 place-items-center rounded-full bg-accent md:h-24 md:w-24" aria-label="Play the video, about 9 minutes">
              <svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 md:h-9 md:w-9" aria-hidden="true"><path d="M6 4l14 8-14 8z" fill="#141310"></path></svg>
            </button>
            <div class="vsl-speeds" role="group" aria-label="Play faster">
              <button type="button" data-rate="1.2">1.2x</button>
              <button type="button" data-rate="1.5">1.5x</button>
              <button type="button" data-rate="1.7">1.7x</button>
              <button type="button" data-rate="2">2x</button>
            </div>
          </div>
        </div>

        <!-- While it plays: tap to pause, a big button when paused, one bar. -->
        <button id="vsl-resume" type="button" class="vsl-resume absolute inset-0 grid place-items-center" aria-label="Play" hidden>
          <span class="vsl-play grid h-14 w-14 place-items-center rounded-full bg-accent md:h-20 md:w-20" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="ml-1 h-5 w-5 md:h-8 md:w-8"><path d="M6 4l14 8-14 8z" fill="#141310"></path></svg>
          </span>
        </button>
        <div id="vsl-bar" class="vsl-bar" hidden>
          <button id="vsl-toggle" type="button" class="vsl-icon" aria-label="Pause">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"></path><path class="i-play" d="M7 4.5l12 7.5-12 7.5z" fill="currentColor"></path></svg>
          </button>
          <span id="vsl-time" class="vsl-time">0:00</span>
          <input id="vsl-seek" class="vsl-seek" type="range" min="0" max="1000" step="1" value="0" aria-label="Seek" />
          <button id="vsl-rate" type="button" class="vsl-rate" aria-label="Playback speed, 1x">1x</button>
          <button id="vsl-full" type="button" class="vsl-icon" aria-label="Full screen">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
          </button>
        </div>
      </div>
    ) : (
      <div class="wt-video wt-soon"><p>The video will be here shortly.</p></div>
    )}

    <section id="wt-book" class="wt-book" hidden>
      <h2>Book your first Blueprint session</h2>
      <p class="wt-sub">It's the top of the U, where we start with you. There's no commitment.</p>

      <fieldset>
        <legend>Do you have an admin or support team?</legend>
        <div class="wt-chips" data-q="has_team">
          <button type="button" data-v="yes">Yes, I have a team</button>
          <button type="button" data-v="no">Not yet</button>
        </div>
      </fieldset>
      <fieldset>
        <legend>What are you looking for?</legend>
        <div class="wt-chips" data-q="looking_for">
          <button type="button" data-v="operations">Help scaling our operations</button>
          <button type="button" data-v="leads">Lead generation</button>
        </div>
      </fieldset>

      <fieldset>
        <legend>Pick a time</legend>
        <p id="wt-loading" class="wt-note">Finding open times...</p>
        <div id="wt-days" class="wt-chips wt-days" hidden></div>
        <div id="wt-times" class="wt-chips" hidden></div>
      </fieldset>

      <div id="wt-turnstile"></div>
      <button id="wt-go" class="wt-go" type="button" disabled>Book this time</button>
      <p id="wt-err" class="wt-err" role="alert"></p>
    </section>

    <section id="wt-done" class="wt-book" hidden>
      <h2 id="wt-done-h">You're booked.</h2>
      <p id="wt-done-when" class="wt-sub"></p>
    </section>

    <p id="wt-nolink" class="wt-note" hidden>To book, open the link in your email or SMS.</p>
  </main>
</Base>

<style is:global>
  /* The bare layout's logo floats over the top of the page, so clear it. */
  .wt { max-width: 860px; margin: 0 auto; padding: calc(var(--nav-h) + 8px) 18px 72px; }
  .wt h1 { font: 800 clamp(1.9rem, 6vw, 3.4rem)/0.98 var(--font-display); text-transform: uppercase; margin: 0 0 16px; color: var(--color-text); }
  .wt-video { display: block; width: 100%; aspect-ratio: 1668 / 1080; background: #1c1b18; border-radius: 4px; }
  .vsl { border-radius: 2px; box-shadow: 0 2px 4px rgb(58 50 36 / 0.08), 0 40px 80px -40px rgb(58 50 36 / 0.55); }
  .vsl:fullscreen { border-radius: 0; background: #141310; }
  .vsl:fullscreen video { object-fit: contain; }
  /* The first frame, greyed: the colour comes back when it plays. */
  .vsl-poster { filter: grayscale(1) contrast(0.92) brightness(0.96); }
  /* Fixed carbon, not --ground: a concrete wash would flatten the poster. */
  .vsl-wash { background: rgb(43 42 38 / 0.42); }
  .vsl-play { cursor: pointer; transition: transform 220ms var(--ease-out); box-shadow: 0 12px 28px -10px rgb(20 19 16 / 0.55); }
  .vsl-play:hover, .vsl-play:focus-visible, .vsl-resume:hover .vsl-play { transform: scale(1.06); }
  .vsl-play:active { transform: scale(0.97); }
  .vsl-speeds { display: flex; gap: 0.25rem; padding: 0.25rem; border-radius: 999px; background: rgb(20 19 16 / 0.55); }
  .vsl-speeds button {
    min-width: 3.1rem; padding: 0.4rem 0.7rem; border-radius: 999px; cursor: pointer;
    color: #ece9e2; font-size: 0.85rem; font-weight: 600; font-variant-numeric: tabular-nums;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .vsl-speeds button:hover, .vsl-speeds button:focus-visible { background: #d1a24f; color: #141310; }
  @media (max-width: 479px) { .vsl-speeds button { min-width: 2.6rem; padding: 0.3rem 0.5rem; font-size: 0.78rem; } }
  .vsl-resume { background: rgb(20 19 16 / 0.25); cursor: pointer; }
  .vsl-bar {
    position: absolute; inset: auto 0 0 0; z-index: 3; display: flex; align-items: center; gap: 0.6rem;
    padding: 1.6rem 0.75rem 0.55rem; color: #ece9e2;
    background: linear-gradient(to top, rgb(20 19 16 / 0.7), rgb(20 19 16 / 0));
    transition: opacity 220ms ease;
  }
  .vsl[data-idle] .vsl-bar { opacity: 0; pointer-events: none; }
  .vsl[data-idle] { cursor: none; }
  .vsl-bar[hidden] { display: none; }
  .vsl-icon { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; flex: none; cursor: pointer; border-radius: 4px; }
  .vsl-icon svg { width: 1.35rem; height: 1.35rem; }
  .vsl .i-play { display: none; }
  .vsl[data-paused] .i-play { display: inline; }
  .vsl[data-paused] .i-pause { display: none; }
  .vsl-time { flex: none; font-size: 0.8rem; font-variant-numeric: tabular-nums; min-width: 4.6rem; }
  .vsl-rate {
    flex: none; min-width: 3.2rem; padding: 0.3rem 0.55rem; border-radius: 999px; cursor: pointer;
    background: rgb(236 233 226 / 0.16); font-size: 0.8rem; font-weight: 700; font-variant-numeric: tabular-nums;
  }
  .vsl-rate:hover, .vsl-rate:focus-visible { background: #d1a24f; color: #141310; }
  .vsl-seek {
    flex: 1; min-width: 0; height: 1.5rem; cursor: pointer; background: transparent;
    -webkit-appearance: none; appearance: none; --p: 0%;
  }
  .vsl-seek::-webkit-slider-runnable-track { height: 4px; border-radius: 2px; background: linear-gradient(to right, #d1a24f var(--p), rgb(236 233 226 / 0.3) var(--p)); }
  .vsl-seek::-moz-range-track { height: 4px; border-radius: 2px; background: rgb(236 233 226 / 0.3); }
  .vsl-seek::-moz-range-progress { height: 4px; border-radius: 2px; background: #d1a24f; }
  .vsl-seek::-webkit-slider-thumb { -webkit-appearance: none; width: 13px; height: 13px; margin-top: -4.5px; border-radius: 50%; background: #ece9e2; border: 0; }
  .vsl-seek::-moz-range-thumb { width: 13px; height: 13px; border-radius: 50%; background: #ece9e2; border: 0; }
  @media (max-width: 479px) { .vsl-time { display: none; } }
  @media (prefers-reduced-motion: reduce) { .vsl-play, .vsl-bar { transition: none; } }
  .wt-soon { display: grid; place-items: center; }
  .wt-soon p { color: #ece9e2; margin: 0; }
  .wt-book { margin-top: 34px; }
  .wt-book h2 { font: 800 clamp(1.8rem, 5vw, 2.6rem)/1 var(--font-display); text-transform: uppercase; margin: 0; color: var(--color-text); }
  .wt-sub { margin: 10px 0 0; color: var(--color-text-2); font-size: 1.05rem; line-height: 1.45; }
  .wt fieldset { border: 0; padding: 0; margin: 24px 0 0; }
  .wt legend { padding: 0; margin-bottom: 10px; font-weight: 600; color: var(--color-text); }
  .wt-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .wt-chips button { min-height: 44px; padding: 8px 16px; border: 1px solid var(--color-line-3); border-radius: 8px; background: transparent; color: var(--color-text); font: 500 0.98rem var(--font-body); cursor: pointer; }
  .wt-chips button:hover { border-color: var(--color-accent-dk); }
  .wt-chips button.is-picked { background: var(--color-accent); border-color: var(--color-accent); color: #141310; font-weight: 600; }
  .wt-times-gap, #wt-times { margin-top: 12px; }
  /* Days and times line up in columns rather than wrapping raggedly. */
  #wt-days:not([hidden]) { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); }
  #wt-times:not([hidden]) { display: grid; grid-template-columns: repeat(auto-fill, minmax(70px, 1fr)); }
  #wt-days button, #wt-times button { padding-inline: 4px; }
  @media (max-width: 520px) { .wt-chips[data-q] button { flex: 1 1 100%; } }
  .wt-note { margin: 0; color: var(--color-text-2); }
  #wt-nolink { margin-top: 24px; }
  .wt-go { display: block; width: 100%; min-height: 56px; margin-top: 24px; border: 0; border-radius: 10px; background: var(--color-accent); color: #141310; font: 800 1.5rem var(--font-display); text-transform: uppercase; cursor: pointer; }
  .wt-go:hover:not(:disabled) { background: var(--color-accent-dk); }
  .wt-go:disabled { opacity: 0.55; cursor: not-allowed; }
  .wt-err { margin: 12px 0 0; color: #8e3524; font-weight: 500; }
  .wt-err:empty { display: none; }
</style>

<script src="../scripts/walkthrough.ts"></script>
