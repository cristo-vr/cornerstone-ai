---
/**
 * The contact form, in two steps, every field required. To the visitor it's
 * simply a two-step form. Behind "Continue", step one (name, email, message)
 * is saved silently in the background, so someone who leaves halfway is still
 * captured; the final "Send" posts everything again and the endpoint folds it
 * into the same lead. Turnstile is verified server-side on both posts.
 */
const TURNSTILE_SITE_KEY = "0x4AAAAAACN3bXEw6zTOBNYc";

const budgets = ["Under $5,000", "$5,000 to $15,000", "$15,000 to $50,000", "More than $50,000", "Not decided yet"];
const authority = ["It's my call", "Me and a partner", "Someone else signs off", "Not sure yet"];
const timelines = ["This month", "Within three months", "Three to six months", "No date yet"];
---
<form id="lead-form" class="grid gap-6" data-step="1" novalidate>
  <div class="progress" role="progressbar" aria-valuemin="1" aria-valuemax="2" aria-valuenow="1" aria-label="Step 1 of 2">
    <span class="progress-bar is-on"></span>
    <span class="progress-bar"></span>
  </div>

  <fieldset id="step-1" class="grid gap-5 border-0 p-0 m-0 min-w-0">
    <legend class="sr-only">Step 1 of 2</legend>
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="field">
        <label for="fullName">Name</label>
        <input class="input" id="fullName" name="fullName" type="text" autocomplete="name" required />
        <span class="error" data-error-for="fullName" aria-live="polite"></span>
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input class="input" id="email" name="email" type="email" autocomplete="email" inputmode="email" required />
        <span class="error" data-error-for="email" aria-live="polite"></span>
      </div>
    </div>
    <div class="field">
      <label for="biggestPain">What's going on in the business</label>
      <textarea class="input" id="biggestPain" name="biggestPain" rows="4" required></textarea>
      <span class="error" data-error-for="biggestPain" aria-live="polite"></span>
    </div>

    <div class="absolute -left-[9999px] opacity-0 h-0 overflow-hidden" aria-hidden="true">
      <label for="company">Company</label>
      <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>
  </fieldset>

  <fieldset id="step-2" hidden class="grid gap-5 border-0 p-0 m-0 min-w-0">
    <legend class="sr-only">Step 2 of 2</legend>
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="field">
        <label for="budget">What budget have you set aside?</label>
        <select class="input" id="budget" name="budget" required>
          <option value="" selected disabled>Pick one</option>
          {budgets.map((b) => <option value={b}>{b}</option>)}
        </select>
        <span class="error" data-error-for="budget" aria-live="polite"></span>
      </div>
      <div class="field">
        <label for="role">Who decides on this?</label>
        <select class="input" id="role" name="role" required>
          <option value="" selected disabled>Pick one</option>
          {authority.map((a) => <option value={a}>{a}</option>)}
        </select>
        <span class="error" data-error-for="role" aria-live="polite"></span>
      </div>
    </div>
    <div class="field">
      <label for="need">What has to be true in six months for this to have been worth it?</label>
      <textarea class="input" id="need" name="need" rows="3" required></textarea>
      <span class="error" data-error-for="need" aria-live="polite"></span>
    </div>
    <div class="field sm:max-w-[50%] sm:pr-2.5">
      <label for="timeline">When do you want to start?</label>
      <select class="input" id="timeline" name="timeline" required>
        <option value="" selected disabled>Pick one</option>
        {timelines.map((t) => <option value={t}>{t}</option>)}
      </select>
      <span class="error" data-error-for="timeline" aria-live="polite"></span>
    </div>
  </fieldset>

  <div class="cf-turnstile min-h-[65px]" data-sitekey={TURNSTILE_SITE_KEY}></div>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary" data-next>Continue</button>
    <button type="button" class="btn btn-ghost" data-back hidden>Back</button>
    <span class="text-[0.82rem] text-text-3"><a href="/privacy" class="link">Privacy</a></span>
  </div>

  <p data-status class="text-[0.9rem] text-danger-ink" aria-live="polite"></p>
</form>

<div id="lead-done" hidden class="slab p-8">
  <p class="display display-3">Got it.</p>
  <p class="mt-3 text-text-2 max-w-[40ch]">You'll hear back within a working day.</p>
</div>

<style>
  .progress {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .progress-bar {
    height: 3px;
    background: var(--color-line-3);
    position: relative;
    overflow: hidden;
  }
  .progress-bar::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 520ms var(--ease-out);
  }
  .progress-bar.is-on::after { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) {
    .progress-bar::after { transition: none; }
  }
</style>
