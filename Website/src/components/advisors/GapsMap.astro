---
/**
 * "Every gap runs through you", as one client's paperwork: five real looking
 * pieces in five systems (a platform statement, an ROA on OneDrive, a Planner
 * card, a Re: Re: Fwd: thread, a row in the FICA sheet), and the one record
 * they land in. Direction 3 of the diagram round, with the grafts:
 *
 *  - Plays once when the record is half on screen. No pin, no scrub.
 *  - The tally ("Questions that reach you") counts down as pieces land.
 *  - Empty rows say "Ask admin", not grey loading bars.
 *  - Reduced motion, or ?still, shows the finished state. ?p=0..1 freezes a
 *    frame for screenshots.
 *
 * The microcopy in here (column labels, row labels, "Ask admin", the tally
 * label) is draft for Cristo's copy pass. Every figure is illustrative.
 */
interface Piece {
  k: string;
  system: string;
  where: string;
  /** Phone card: kind, headline, one real detail. */
  m: [string, string, string];
}
const pieces: Piece[] = [
  { k: "aua", system: "Platform portal", where: "Glacier", m: ["Statement Q3", "R 4 812 330", "Glacier"] },
  { k: "roa", system: "OneDrive", where: "/Clients/P/2026", m: ["PDF", "ROA_FINAL_v3 (2).pdf", "Signed 14 Aug"] },
  { k: "work", system: "Planner", where: "Reviews Q4", m: ["Task, 3 of 7", "Annual review pack", "Due Fri 31 Oct"] },
  { k: "mail", system: "Inbox", where: "info@ shared mailbox", m: ["Re: Re: Fwd:", "Beneficiary nomination", "6 messages"] },
  { k: "fica", system: "Compliance spreadsheet", where: "FICA_tracker_2026.xlsx", m: ["Row 212", "Proof of address", "Expired 03 Sep"] },
];
const by = Object.fromEntries(pieces.map((p) => [p.k, p]));
---
<figure class="gm" data-gm aria-label="One client's details spread across five systems, then filed into one client record.">
  <header class="gm-head">
    <span class="gm-fig">Fig. 1 · One client, five systems</span>
    <span class="gm-fig gm-ill">Illustrative</span>
  </header>
  <div class="gm-rule" aria-hidden="true"><span data-gm-fill></span></div>

  <div class="gm-body">
    <div class="gm-today">
      <div class="gm-col"><span>One client, today</span><span>Five systems, five logins</span></div>
      <div class="gm-silos">
        {pieces.map((p) => (
          <div class={`gm-silo gm-s-${p.k}`} data-k={p.k}>
            <div class="gm-name">{p.system} <em>{p.where}</em><span class="gm-linked">Linked</span></div>
            <div class="gm-slot">
              <article class={`gm-frag gm-f-${p.k}`}>
                {p.k === "aua" && (
                  <div class="gm-d">
                    <div class="gm-k"><span>Investment statement</span><span class="gm-tn">Q3 2026</span></div>
                    <h4>Living annuity</h4>
                    <div class="gm-sub gm-tn">Policy LA-882140, 1 Jul to 30 Sep 2026</div>
                    <table class="gm-tn">
                      <tr><td>Opening value</td><td>R 4 691 004</td></tr>
                      <tr><td>Income drawn</td><td>(R 64 520)</td></tr>
                      <tr><td>Investment growth</td><td>R 185 846</td></tr>
                      <tr class="gm-opt"><td>Drawdown rate</td><td>5.50%</td></tr>
                      <tr class="gm-total"><td>Closing value</td><td>R 4 812 330</td></tr>
                    </table>
                  </div>
                )}
                {p.k === "roa" && (
                  <div class="gm-d gm-pdf">
                    <div class="gm-tab">PDF</div>
                    <div class="gm-pg">
                      <div class="gm-fn">ROA_Pillay_140826_FINAL_v3 (2).pdf</div>
                      <div class="gm-doc"><strong>Record of Advice</strong>Need: retirement income, estate liquidity. Retain the annuity, reduce drawdown at anniversary.</div>
                      <div class="gm-sig"><span>Client signature</span><span class="gm-tn">14 Aug 2026</span></div>
                    </div>
                  </div>
                )}
                {p.k === "work" && (
                  <div class="gm-d">
                    <div class="gm-k"><span>Reviews Q4</span><span class="gm-tn">3 of 7</span></div>
                    <h5>Annual review pack: Pillay</h5>
                    <ul>
                      <li class="gm-done">Pull platform valuations</li>
                      <li>Update cash-flow model</li>
                      <li>Draft review letter</li>
                    </ul>
                    <div class="gm-meta"><span><span class="gm-av">AD</span>Admin</span><span class="gm-tn">Due Fri 31 Oct</span></div>
                  </div>
                )}
                {p.k === "mail" && (
                  <div class="gm-d">
                    <div class="gm-top"><b>R. Pillay</b><span class="gm-tn">Tue 09:14, 6 messages</span></div>
                    <div class="gm-subj"><span>Re: Re: Fwd:</span> Beneficiary nomination</div>
                    <div class="gm-snip">Sorry, did you get the signed one? I sent it to the other address last week.</div>
                  </div>
                )}
                {p.k === "fica" && (
                  <div class="gm-d">
                    <div class="gm-bar"><b>Sheet1</b><span>Sheet1 (old)</span><span>DO NOT EDIT</span></div>
                    <table class="gm-tn">
                      <tr><th></th><th>Client</th><th>ID verified</th><th>Proof of address</th><th>Risk</th><th>Last checked</th></tr>
                      <tr class="gm-dim"><td class="gm-n">211</td><td>Pienaar, J</td><td>Yes</td><td>Valid to Mar 2027</td><td>Low</td><td>04 Feb</td></tr>
                      <tr><td class="gm-n">212</td><td>Pillay, R &amp; S</td><td>Yes</td><td class="gm-flag">Expired 03 Sep</td><td>Medium</td><td>11 Mar</td></tr>
                    </table>
                  </div>
                )}
                <div class="gm-m"><small>{p.m[0]}</small><span>{p.m[1]}</span><i>{p.m[2]}</i></div>
              </article>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="gm-built">
      <div class="gm-col"><span>The same client, built</span><span>Open to the whole team</span></div>
      <article class="gm-rec" aria-label="Client record" data-gm-rec>
        <span class="gm-rec-bar" data-gm-bar aria-hidden="true"></span>
        <div class="gm-rec-head">
          <div class="gm-k"><span>Client record</span><span class="gm-tn">H-0417</span></div>
          <h3>Pillay household</h3>
          <div class="gm-who">Two lives. Client since 2014. Review month: August.</div>
        </div>
        <ol class="gm-rows">
          <li class="gm-row" data-row="aua"><span class="gm-lbl">Under advice</span><div class="gm-val"><span class="gm-empty">Ask admin</span><div class="gm-v gm-tn">R 4 812 330</div><div class="gm-src">Platform statement, 30 Sep</div></div></li>
          <li class="gm-row" data-row="roa"><span class="gm-lbl">Last advice</span><div class="gm-val"><span class="gm-empty">Ask admin</span><div class="gm-v gm-tn">ROA signed 14 Aug 2026</div><div class="gm-src">Next review due Aug 2027</div></div></li>
          <li class="gm-row" data-row="work"><span class="gm-lbl">Open work</span><div class="gm-val"><span class="gm-empty">Ask admin</span><div class="gm-v gm-tn">Review pack, 3 of 7 done</div><div class="gm-src">Admin, due Fri 31 Oct</div></div></li>
          <li class="gm-row" data-row="mail"><span class="gm-lbl">Waiting on</span><div class="gm-val"><span class="gm-empty">Ask admin</span><div class="gm-v">Signed beneficiary form</div><div class="gm-src">Client thread filed, 6 messages</div></div></li>
          <li class="gm-row" data-row="fica"><span class="gm-lbl">FICA</span><div class="gm-val"><span class="gm-empty">Ask admin</span><div class="gm-v">Proof of address <span class="gm-tag">Expired</span></div><div class="gm-src">Request sent to client 04 Sep</div></div></li>
        </ol>
        <div class="gm-foot">
          <span>Sources linked <b data-gm-count>0</b> of 5</span>
          <span class="gm-tally" aria-hidden="true"><b class="gm-tally-n" data-gm-asks>5</b>Questions that reach you</span>
        </div>
      </article>
    </div>
  </div>
</figure>

<style is:global>
  .gm {
    --gm-paper: var(--color-surface-3);
    --gm-paper-2: #ebeae5;
    --gm-sunken: #dddcd6;
    --gm-muted: #6b6960;
    --gm-shadow-1: 0 1px 0 rgb(255 253 247 / 0.75) inset, 0 1px 2px rgb(58 50 36 / 0.1), 0 8px 16px -8px rgb(58 50 36 / 0.18), 0 24px 44px -26px rgb(58 50 36 / 0.3);
    --gm-shadow-card: 0 1px 0 rgb(255 253 247 / 0.85) inset, 0 2px 4px rgb(58 50 36 / 0.07), 0 34px 64px -34px rgb(58 50 36 / 0.42);
    position: relative; margin: 0;
  }
  .gm-tn { font-variant-numeric: tabular-nums; }

  .gm-head { display: flex; justify-content: space-between; gap: 1rem; padding-top: 0.7rem; border-top: 2px solid var(--color-text); }
  .gm-fig { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text); }
  .gm-ill { color: var(--color-text-3); font-weight: 600; }
  .gm-rule { position: relative; height: 2px; margin-top: 0.7rem; background: var(--color-line-2); overflow: hidden; }
  .gm-rule span { position: absolute; inset: 0; background: var(--color-accent); transform-origin: left; transform: scaleX(0); }

  .gm-body { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 3.5rem; padding-top: 1.75rem; }
  .gm-col { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-bottom: 0.75rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-3); }
  .gm-col span:last-child { font-weight: 500; letter-spacing: 0.02em; text-transform: none; font-size: 0.76rem; }

  /* the pieces, today */
  .gm-silos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.4rem; grid-template-areas: "aua roa" "aua work" "mail work" "fica fica"; }
  .gm-s-aua { grid-area: aua; } .gm-s-roa { grid-area: roa; } .gm-s-work { grid-area: work; } .gm-s-mail { grid-area: mail; } .gm-s-fica { grid-area: fica; }
  .gm-silo { border-top: 1px solid var(--color-line-3); padding-top: 0.5rem; min-width: 0; }
  .gm-name { display: flex; align-items: center; gap: 0.6rem; font-size: 0.74rem; font-weight: 600; color: var(--color-text-2); margin-bottom: 0.55rem; }
  .gm-name em { font-style: normal; color: var(--gm-muted); font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gm-linked { margin-left: auto; display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; color: var(--color-text); opacity: 0; transform: translateX(-4px); transition: opacity 0.3s ease, transform 0.4s var(--ease-out); }
  .gm-linked::before { content: ""; width: 7px; height: 7px; background: var(--color-accent); }
  .gm-silo.is-filed .gm-linked { opacity: 1; transform: none; }
  .gm-silo.is-filed .gm-name em { display: none; }
  .gm-slot { position: relative; }

  .gm-frag { position: relative; background: var(--gm-paper); box-shadow: var(--gm-shadow-1); color: var(--color-text); rotate: var(--r, 0deg); transition: opacity 0.45s ease, filter 0.45s ease; }
  .gm-frag.is-fly { position: absolute; left: 0; top: 0; width: 100%; z-index: 6; transform-origin: 0 0; will-change: transform, opacity; pointer-events: none; opacity: 0;
    box-shadow: 0 1px 0 rgb(255 253 247 / 0.75) inset, 0 2px 4px rgb(58 50 36 / 0.12), 0 30px 50px -24px rgb(58 50 36 / 0.42);
    transition: none; }
  /* Filed, not gone: still legible, the Linked square says it moved. */
  .gm-frag.is-src.is-dim { opacity: 0.78; filter: saturate(0.4); }
  @media (hover: hover) and (pointer: fine) {
    .gm-silo.is-hot .gm-frag.is-src { opacity: 1; filter: none; box-shadow: var(--gm-shadow-1), 0 0 0 1px var(--color-text); }
    .gm-row { transition: background-color 0.2s ease; }
    .gm-row.is-hot { background: var(--gm-paper-2); }
  }
  .gm-m { display: none; }

  .gm-k { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-3); }
  .gm-f-aua { --r: -1.1deg; padding: 1rem 1.1rem 0.9rem; }
  .gm-f-aua h4 { font-family: var(--font-display); font-weight: 800; font-size: 1.3rem; text-transform: uppercase; letter-spacing: 0.01em; margin: 0.6rem 0 0.1rem; line-height: 1; }
  .gm-sub { font-size: 0.72rem; color: var(--color-text-3); margin-bottom: 0.6rem; }
  .gm-f-aua table { width: 100%; border-collapse: collapse; font-size: 0.75rem; }
  .gm-f-aua td { padding: 0.3rem 0; border-top: 1px solid var(--color-line); }
  .gm-f-aua td:last-child { text-align: right; }
  .gm-f-aua tr.gm-total td { border-top: 1.5px solid var(--color-text); font-weight: 700; padding-top: 0.45rem; font-size: 0.84rem; }

  .gm-f-roa { --r: 1.3deg; }
  .gm-pdf { display: grid; grid-template-columns: 40px 1fr; }
  .gm-tab { background: var(--gm-sunken); padding-top: 0.75rem; text-align: center; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.08em; color: var(--color-text-2); }
  .gm-pg { padding: 0.7rem 0.9rem; min-width: 0; }
  .gm-fn { font-size: 0.68rem; font-weight: 600; color: var(--color-text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gm-doc { margin-top: 0.5rem; font-size: 0.7rem; color: var(--color-text-2); line-height: 1.45; }
  .gm-doc strong { display: block; font-size: 0.78rem; color: var(--color-text); margin-bottom: 1px; }
  .gm-sig { margin-top: 0.55rem; display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--gm-muted); border-top: 1px solid var(--color-text-3); padding-top: 0.25rem; }

  .gm-f-work { --r: 0.9deg; padding: 0.8rem 0.9rem 0.75rem; }
  .gm-f-work h5 { font-size: 0.9rem; font-weight: 700; margin: 0.4rem 0 0.6rem; line-height: 1.25; }
  .gm-f-work ul { list-style: none; padding: 0; font-size: 0.72rem; color: var(--color-text-2); display: grid; gap: 0.3rem; }
  .gm-f-work li { display: flex; gap: 0.45rem; align-items: center; }
  .gm-f-work li::before { content: ""; width: 10px; height: 10px; border: 1.25px solid var(--color-text-3); flex: none; }
  .gm-f-work li.gm-done { color: var(--gm-muted); text-decoration: line-through; text-decoration-color: var(--color-line-2); }
  .gm-f-work li.gm-done::before { background: var(--color-text-3); }
  .gm-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem; padding-top: 0.55rem; border-top: 1px solid var(--color-line); font-size: 0.68rem; color: var(--color-text-3); }
  .gm-av { width: 22px; height: 22px; border-radius: 50%; background: var(--gm-sunken); display: inline-flex; align-items: center; justify-content: center; font-size: 0.56rem; font-weight: 700; color: var(--color-text-2); margin-right: 0.4rem; }

  .gm-f-mail { --r: -0.5deg; padding: 0.7rem 0.9rem 0.75rem; }
  .gm-top { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; font-size: 0.76rem; }
  .gm-top span { font-size: 0.68rem; color: var(--gm-muted); }
  .gm-subj { margin-top: 0.2rem; font-size: 0.78rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gm-subj span { color: var(--gm-muted); font-weight: 500; }
  .gm-snip { margin-top: 0.15rem; font-size: 0.72rem; color: var(--color-text-3); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .gm-f-fica { --r: -0.4deg; font-size: 0.7rem; overflow: hidden; }
  .gm-bar { display: flex; gap: 1rem; padding: 0.4rem 0.6rem; background: var(--gm-paper-2); border-bottom: 1px solid var(--color-line); color: var(--color-text-3); font-weight: 600; font-size: 0.7rem; }
  .gm-bar b { color: var(--color-text); }
  .gm-f-fica table { border-collapse: collapse; width: 100%; }
  .gm-f-fica th, .gm-f-fica td { border-right: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: 0.3rem 0.5rem; text-align: left; white-space: nowrap; }
  .gm-f-fica tr:last-child td { border-bottom: 0; }
  .gm-f-fica th { font-weight: 600; color: var(--gm-muted); background: var(--gm-paper-2); font-size: 0.7rem; }
  .gm-f-fica td.gm-n { color: var(--gm-muted); background: var(--gm-paper-2); width: 34px; text-align: right; }
  .gm-f-fica tr.gm-dim td:not(.gm-n) { color: var(--gm-muted); }
  .gm-f-fica td.gm-flag { box-shadow: inset 0 0 0 1.5px var(--color-text); font-weight: 700; }

  /* the record, built */
  .gm-rec { position: relative; background: var(--gm-paper); box-shadow: var(--gm-shadow-card); }
  .gm-rec-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--color-accent); transform-origin: top; transform: scaleY(0); }
  .gm-rec-head { padding: 1.25rem 1.5rem 1rem 1.75rem; border-bottom: 1px solid var(--color-line); }
  .gm-rec-head h3 { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: 2rem; line-height: 0.95; margin-top: 0.6rem; }
  .gm-who { margin-top: 0.45rem; font-size: 0.78rem; color: var(--color-text-3); }
  .gm-rows { list-style: none; padding: 0; margin: 0; }
  .gm-row { display: grid; grid-template-columns: 7rem 1fr; gap: 0.9rem; padding: 0.75rem 1.5rem 0.75rem 1.75rem; border-bottom: 1px solid var(--color-line); min-height: 3.9rem; }
  .gm-lbl { display: flex; align-items: center; gap: 0.5rem; height: 1.2rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--color-text-3); transition: color 0.3s ease; }
  .gm-val { position: relative; min-width: 0; }
  .gm-v { font-size: 0.92rem; font-weight: 600; line-height: 1.3; opacity: 0; transform: translateY(5px); transition: opacity 0.35s var(--ease-out), transform 0.5s var(--ease-out); }
  .gm-src { font-size: 0.7rem; color: var(--gm-muted); margin-top: 0.2rem; opacity: 0; transition: opacity 0.4s ease 0.1s; }
  .gm-empty { position: absolute; left: 0; top: 0; font-size: 0.86rem; font-style: italic; line-height: 1.3; color: var(--color-text-2); transition: opacity 0.25s ease; }
  .gm-row.is-in .gm-v { opacity: 1; transform: none; }
  .gm-row.is-in .gm-src { opacity: 1; }
  .gm-row.is-in .gm-empty, .gm-row.is-near .gm-empty { opacity: 0; }
  .gm-row.is-in .gm-lbl { color: var(--color-text); }
  .gm-tag { display: inline-block; box-shadow: inset 0 0 0 1.5px var(--color-text); color: var(--color-text); font-size: 0.66rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; padding: 2px 6px; margin-left: 0.4rem; vertical-align: 2px; }
  .gm-foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.75rem 1.5rem 0.8rem 1.75rem; background: var(--gm-paper-2); font-size: 0.74rem; color: var(--color-text-3); }
  .gm-foot b { color: var(--color-text); font-variant-numeric: tabular-nums; }
  .gm-tally { display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-2); }
  .gm-tally-n { font-family: var(--font-display); font-weight: 800; font-size: 2.25rem; line-height: 0.8; letter-spacing: 0; min-width: 0.55em; text-align: right; }

  @media (min-width: 768px) and (max-height: 820px) {
    .gm-f-aua tr.gm-opt, .gm-bar { display: none; }
    .gm-row { min-height: 3.4rem; padding-top: 0.55rem; padding-bottom: 0.55rem; }
  }

  /* phone: the pieces become summary cards, the record sits under them */
  @media (max-width: 767px) {
    .gm-body { grid-template-columns: 1fr; gap: 1.75rem; padding-top: 1.25rem; }
    .gm-col { font-size: 0.66rem; padding-bottom: 0.55rem; }
    .gm-col span:last-child { font-size: 0.68rem; }
    .gm-silos { gap: 0.6rem; grid-template-areas: "aua roa" "work fica" "mail mail"; }
    .gm-silo { padding-top: 0.3rem; }
    .gm-name { font-size: 0.68rem; margin-bottom: 0.35rem; }
    .gm-name em { display: none; }
    .gm-linked { font-size: 0; gap: 0; order: -1; margin-left: 0; transform: none; }
    .gm-d { display: none; }
    .gm-frag { rotate: 0deg; padding: 0; }
    .gm-m { display: block; padding: 0.55rem 0.7rem 0.6rem; }
    .gm-m small { display: block; font-size: 0.64rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-3); }
    .gm-m span { display: block; margin-top: 0.15rem; font-size: 0.8rem; font-weight: 600; line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gm-m i { display: block; margin-top: 0.15rem; font-style: normal; font-size: 0.68rem; color: var(--color-text-3); }
    .gm-frag.is-src.is-dim { opacity: 1; filter: none; }
    .gm-silo.is-filed .gm-frag.is-src .gm-m span { color: var(--color-text-2); }
    .gm-rec-head { padding: 0.8rem 0.9rem 0.65rem 1.1rem; }
    .gm-rec-head h3 { font-size: 1.5rem; margin-top: 0.3rem; }
    .gm-who { font-size: 0.7rem; margin-top: 0.2rem; }
    .gm-k { font-size: 0.64rem; }
    .gm-row { grid-template-columns: 5.4rem 1fr; gap: 0.5rem; padding: 0.5rem 0.9rem 0.5rem 1.1rem; min-height: 3rem; }
    .gm-lbl { font-size: 0.62rem; gap: 0.35rem; }
    .gm-v { font-size: 0.82rem; }
    .gm-empty { font-size: 0.8rem; }
    .gm-src { font-size: 0.64rem; margin-top: 0.05rem; }
    .gm-foot { padding: 0.55rem 0.9rem 0.6rem 1.1rem; font-size: 0.66rem; }
    .gm-tally { font-size: 0.64rem; gap: 0.45rem; }
    .gm-tally-n { font-size: 1.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gm-frag, .gm-v, .gm-src, .gm-empty, .gm-linked, .gm-lbl, .gm-m { transition: none; }
  }
</style>

<script>
  // One shot: when the record is half on screen, the five pieces fly into it
  // over two seconds. rAF runs only while it plays; nothing listens to scroll.
  const root = document.querySelector<HTMLElement>("[data-gm]");
  if (root) {
    const rec = root.querySelector<HTMLElement>("[data-gm-rec]")!;
    const items = Array.from(root.querySelectorAll<HTMLElement>(".gm-silo")).map((silo) => {
      const src = silo.querySelector<HTMLElement>(".gm-frag")!;
      const fly = src.cloneNode(true) as HTMLElement;
      src.classList.add("is-src");
      fly.classList.add("is-fly");
      fly.setAttribute("aria-hidden", "true");
      silo.querySelector(".gm-slot")!.append(fly);
      return { silo, src, fly, row: root.querySelector<HTMLElement>(`[data-row="${silo.dataset.k}"]`)! };
    });
    // Land in the record's own order, top to bottom.
    items.sort((a, b) => a.row.offsetTop - b.row.offsetTop);
    const fill = root.querySelector<HTMLElement>("[data-gm-fill]")!;
    const bar = root.querySelector<HTMLElement>("[data-gm-bar]")!;
    const count = root.querySelector<HTMLElement>("[data-gm-count]")!;
    const asks = root.querySelector<HTMLElement>("[data-gm-asks]")!;
    const q = new URLSearchParams(location.search);
    const forced = q.has("still") ? 1 : q.get("p") !== null ? Number(q.get("p")) : null;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const DURATION = 2000;

    let geo: { dx: number; dy: number; s: number; r: number }[] = [];
    const measure = () => {
      geo = items.map(({ fly, row }) => {
        fly.style.transform = "";
        fly.style.rotate = "";
        const a = fly.getBoundingClientRect();
        const t = row.querySelector(".gm-val")!.getBoundingClientRect();
        const s = clamp(Math.min(t.width / a.width, (t.height * 2.4) / a.height), 0.3, 1);
        return { dx: t.left - a.left, dy: t.top - a.top - 2, s, r: parseFloat(getComputedStyle(fly).getPropertyValue("--r")) || 0 };
      });
    };

    let p = 0;
    const paint = (to: number) => {
      p = to;
      fill.style.transform = `scaleX(${p})`;
      bar.style.transform = `scaleY(${clamp(p / 0.92)})`;
      let n = 0;
      items.forEach((it, i) => {
        const g = geo[i];
        const local = clamp((p - 0.04 - i * 0.16) / 0.3);
        const e = ease(local);
        const landed = local >= 0.82;
        n += Number(landed);
        it.row.classList.toggle("is-in", landed);
        // The placeholder clears before the value and the clone never overlap.
        it.row.classList.toggle("is-near", local > 0.55);
        it.silo.classList.toggle("is-filed", landed);
        it.src.classList.toggle("is-dim", local > 0.05);
        it.fly.style.transform = `translate(${g.dx * e}px, ${g.dy * e}px) scale(${1 + (g.s - 1) * e})`;
        it.fly.style.rotate = `${g.r * (1 - e)}deg`;
        it.fly.style.opacity = local <= 0 || local >= 1 ? "0" : String(1 - clamp((local - 0.6) / 0.15));
      });
      count.textContent = String(n);
      asks.textContent = String(5 - n);
    };

    const play = () => {
      measure();
      const t0 = performance.now();
      const tick = (now: number) => {
        paint(clamp((now - t0) / DURATION));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const start = () => {
      measure();
      if (forced !== null) return paint(clamp(forced));
      if (reduce || !("IntersectionObserver" in window)) return paint(1);
      paint(0);
      const io = new IntersectionObserver(
        ([en]) => {
          if (!en.isIntersecting) return;
          io.disconnect();
          play();
        },
        { threshold: 0.5 },
      );
      io.observe(rec);
    };
    addEventListener("resize", () => {
      measure();
      paint(p);
    });
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(start);

    // Desktop: pointing at a row lights the piece it came from.
    if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
      for (const it of items) {
        it.row.addEventListener("mouseenter", () => { it.silo.classList.add("is-hot"); it.row.classList.add("is-hot"); });
        it.row.addEventListener("mouseleave", () => { it.silo.classList.remove("is-hot"); it.row.classList.remove("is-hot"); });
      }
    }
  }
</script>
