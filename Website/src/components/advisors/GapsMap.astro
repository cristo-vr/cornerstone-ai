---
/**
 * "Every gap runs through you": the practice's tools as blocks that never
 * connect to each other, each with a dotted line to the advisor in the
 * middle. Drawn fresh for the page (not lifted from the VSL). Two layouts,
 * because one viewBox can't keep labels readable at 375px and at 1200px.
 */
import { createRequire } from "node:module";
import { readFileSync } from "node:fs";

const require = createRequire(import.meta.url);
const icon = (name: string) =>
  readFileSync(require.resolve(`@phosphor-icons/core/assets/light/${name}-light.svg`), "utf8")
    .replace(/^<svg[^>]*>/, "")
    .replace(/<\/svg>\s*$/, "");

interface Node {
  lines: string[];
  /** Line breaks for the narrow layout, when they differ. */
  phone?: string[];
  icon: string;
}
const nodes: Node[] = [
  { lines: ["Glacier, Allan Gray,", "Momentum"], phone: ["Glacier,", "Allan Gray,", "Momentum"], icon: icon("bank") },
  { lines: ["OneDrive"], icon: icon("folder-simple") },
  { lines: ["Planner"], icon: icon("list-checks") },
  { lines: ["Everyone's inbox"], icon: icon("tray") },
  { lines: ["Compliance", "spreadsheet"], icon: icon("table") },
  { lines: ["WhatsApp"], icon: icon("chat-circle") },
];

interface Box {
  x: number;
  y: number;
  w: number;
  h: number;
}
interface Layout {
  vb: [number, number];
  nodes: Box[];
  you: Box;
  font: number;
  pad: number;
  phone?: boolean;
}

// Desktop: three a side, You in the middle.
const wide: Layout = {
  vb: [960, 440],
  font: 17,
  pad: 16,
  you: { x: 405, y: 185, w: 150, h: 70 },
  nodes: [
    { x: 20, y: 30, w: 250, h: 72 },
    { x: 20, y: 184, w: 250, h: 72 },
    { x: 20, y: 338, w: 250, h: 72 },
    { x: 690, y: 30, w: 250, h: 72 },
    { x: 690, y: 184, w: 250, h: 72 },
    { x: 690, y: 338, w: 250, h: 72 },
  ],
};
// Phone: two above, one each side of You, two below. Indexed like `nodes`.
const tall: Layout = {
  vb: [340, 420],
  font: 13,
  pad: 10,
  phone: true,
  you: { x: 128, y: 174, w: 84, h: 72 },
  nodes: [
    { x: 0, y: 0, w: 158, h: 64 },
    { x: 0, y: 178, w: 108, h: 64 },
    { x: 0, y: 356, w: 158, h: 64 },
    { x: 182, y: 0, w: 158, h: 64 },
    { x: 182, y: 356, w: 158, h: 64 },
    { x: 232, y: 178, w: 108, h: 64 },
  ],
};

/** The line from a node's nearest edge to You's nearest edge. */
function link(n: Box, you: Box) {
  const ncx = n.x + n.w / 2;
  const ncy = n.y + n.h / 2;
  const ycx = you.x + you.w / 2;
  const ycy = you.y + you.h / 2;
  const side = Math.abs(ncx - ycx) > n.w / 2 + you.w / 2;
  if (side) {
    const fromX = ncx < ycx ? n.x + n.w : n.x;
    const toX = ncx < ycx ? you.x : you.x + you.w;
    return { x1: fromX, y1: ncy, x2: toX, y2: ycy + (ncy - ycy) * 0.25 };
  }
  const fromY = ncy < ycy ? n.y + n.h : n.y;
  const toY = ncy < ycy ? you.y : you.y + you.h;
  return { x1: ncx, y1: fromY, x2: ycx + (ncx - ycx) * 0.35, y2: toY };
}

const layouts = [
  { l: wide, cls: "hidden md:block" },
  { l: tall, cls: "md:hidden" },
];
---
<figure class="gaps">
  {layouts.map(({ l, cls }) => (
    <svg class={`gaps-svg ${cls}`} viewBox={`0 0 ${l.vb[0]} ${l.vb[1]}`} role="img" aria-labelledby="gaps-title">
      <title id="gaps-title">Your provider platforms, OneDrive, the planner, everyone's inbox, the compliance spreadsheet and WhatsApp. None of them connect to each other. Each one has a line to you.</title>
      <g class="gaps-lines">
        {l.nodes.map((n) => {
          const k = link(n, l.you);
          return <line x1={k.x1} y1={k.y1} x2={k.x2} y2={k.y2} />;
        })}
      </g>
      {l.nodes.map((n, i) => {
        const node = nodes[i];
        const iconSize = l.font + 7;
        const textX = n.x + l.pad + iconSize + l.pad * 0.7;
        const lh = l.font * 1.2;
        const lines = (l.phone && node.phone) || node.lines;
        const firstY = n.y + n.h / 2 - ((lines.length - 1) * lh) / 2;
        return (
          <g class="gaps-node">
            <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="2" />
            <svg x={n.x + l.pad} y={n.y + n.h / 2 - iconSize / 2} width={iconSize} height={iconSize} viewBox="0 0 256 256" class="gaps-icon" set:html={node.icon} />
            <text x={textX} y={firstY} font-size={l.font} dominant-baseline="central">
              {lines.map((line, j) => (
                <tspan x={textX} dy={j === 0 ? 0 : lh}>{line}</tspan>
              ))}
            </text>
          </g>
        );
      })}
      <g class="gaps-you">
        <rect x={l.you.x} y={l.you.y} width={l.you.w} height={l.you.h} rx="2" />
        <text x={l.you.x + l.you.w / 2} y={l.you.y + l.you.h / 2} text-anchor="middle" dominant-baseline="central" font-size={l.font * 1.5}>You</text>
      </g>
    </svg>
  ))}
</figure>

<style>
  .gaps-svg { width: 100%; height: auto; overflow: visible; }
  .gaps-lines line {
    stroke: var(--color-line-4);
    stroke-width: 1.5;
    stroke-dasharray: 3 6;
    stroke-linecap: round;
    animation: gaps-flow 1.6s linear infinite;
  }
  @keyframes gaps-flow { to { stroke-dashoffset: -9; } }
  @media (prefers-reduced-motion: reduce) { .gaps-lines line { animation: none; } }
  .gaps-node rect { fill: var(--color-surface-3); stroke: var(--color-line-2); stroke-width: 1; }
  .gaps-node text { fill: var(--color-text); font-family: var(--font-body); font-weight: 550; }
  .gaps-icon { color: var(--color-text-3); }
  .gaps-you rect { fill: var(--color-accent); }
  .gaps-you text { fill: var(--color-accent-txt); font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; }
</style>
