---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Mark from "../components/Mark.astro";

interface Props {
  title: string;
  description: string;
  /** Path of the OG image, absolute from the site root. */
  image?: string;
  /** The home page uses in-page anchors in the nav. */
  home?: boolean;
  /** Minimal nav chrome for the newsletter and legal pages. */
  minimal?: boolean;
  noindex?: boolean;
  /** Extra JSON-LD blocks for this page. */
  jsonLd?: Record<string, unknown>[];
  /** A paid landing page: logo only, no menu, a one-line footer. Nothing on the
   *  page leads anywhere but the page's own ask. */
  bare?: boolean;
}

const {
  title,
  description,
  image = "/og.png",
  home = false,
  minimal = false,
  noindex = false,
  jsonLd = [],
  bare = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://cornerstone-ai.pro");
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(image, site).toString();

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Cornerstone AI",
  url: site.toString(),
  email: "info@cornerstone-ai.pro",
  description,
  founder: { "@type": "Person", name: "Cristo Van Rensburg", jobTitle: "Founder" },
  address: { "@type": "PostalAddress", addressCountry: "ZA" },
  areaServed: ["ZA", "US", "GB", "AU"],
  priceRange: "$$$",
};
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#141310" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cornerstone AI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_ZA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/brand/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/cornerstone-plate-flat.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/cornerstone-plate-192.png" />

    <link rel="preload" href="/fonts/big-shoulders-display.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>document.documentElement.classList.remove("no-js");</script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(org)} />
    {jsonLd.map((block) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <slot name="head" />
  </head>
  <body class="grain">
    <!-- The rough-cast filter, declared once for every mark on the page. -->
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <defs>
        <filter id="rc" x="-25%" y="-25%" width="150%" height="150%">
          <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" seed="8" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="3.5" />
        </filter>
      </defs>
    </svg>

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-ground focus:px-4 focus:py-2 focus:border focus:border-text">Skip to content</a>

    {bare ? (
      <header class="absolute inset-x-0 top-0 z-50">
        <div class="wrap flex items-center justify-center md:justify-start" style="height: var(--nav-h)">
          <span class="flex items-center gap-3" aria-label="Cornerstone AI">
            <Mark size={30} rough={true} />
            <span class="display text-[1.35rem] tracking-[0.05em] leading-none translate-y-[1px]">Cornerstone</span>
          </span>
        </div>
      </header>
    ) : (
      <Nav home={home} minimal={minimal} />
    )}

    <main id="main">
      <slot />
    </main>

    {bare ? (
      <footer class="border-t border-line py-8">
        <div class="wrap flex flex-wrap items-center justify-between gap-4 text-[0.85rem] text-text-3">
          <span>&copy; {new Date().getFullYear()} Cornerstone AI</span>
          <span class="flex gap-5">
            <a class="link" href="/privacy">Privacy</a>
            <a class="link" href="/terms">Terms</a>
          </span>
        </div>
      </footer>
    ) : (
      <Footer />
    )}

    {!bare && <script src="../scripts/site.ts"></script>}
  </body>
</html>
